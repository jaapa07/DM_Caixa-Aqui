# =====================================================================
# DM Caixa Aqui — Gestão Operacional · variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione credenciais reais.
# =====================================================================

# --- Banco de dados (Supabase › Project Settings › Database › Connection string)
# Use a conexão do pooler em modo SESSÃO (porta 5432) ou a conexão direta.
# O servidor conecta como "postgres" e, a cada requisição, assume o papel
# "authenticated" com o ID do usuário — todas as políticas RLS são aplicadas.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10

# --- Supabase (Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-anon
# Somente no servidor (nunca use prefixo NEXT_PUBLIC_): upload/URLs assinadas e criação de usuários
SUPABASE_SERVICE_ROLE_KEY=chave-de-servico
SUPABASE_STORAGE_BUCKET=case-documents

# --- Drivers: "supabase" em produção. "local" só para desenvolvimento/testes sem Supabase
AUTH_DRIVER=supabase
STORAGE_DRIVER=supabase

# --- URL pública da aplicação (links de recuperação de senha)
APP_URL=http://localhost:3000

# --- Somente para desenvolvimento local SEM Supabase (PostgreSQL comum + shim)
# LOCAL_SUPABASE_SHIM=true
# AUTH_DRIVER=local
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./.local-storage
# SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# DATABASE_URL=postgresql://postgres@127.0.0.1:54329/dmcaixa

# --- Dados de demonstração (npm run seed) — apenas desenvolvimento/homologação
# DEMO_PASSWORD=defina-uma-senha-forte-de-teste
# SEED_CONFIRM=sim   # necessário para semear um projeto Supabase remoto de TESTE

# --- Primeiro administrador (npm run setup:admin)
# ORG_NAME="DM Caixa Aqui"
# ORG_SLUG=dm-caixa-aqui
# ADMIN_NAME="Nome do administrador"
# ADMIN_EMAIL=admin@empresa.com.br
# ADMIN_PASSWORD=senha-forte-inicial
